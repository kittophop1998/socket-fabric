APP_ENV=development
SOCKETFABRIC_MODE=single
# Optional log label; each process adds a fresh random suffix to its effective ID.
NODE_ID=
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
LOG_LEVEL=info
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# Generate independent random values; the service rejects missing/short credentials.
# See README for commands. Never commit a filled .env file.
CLIENT_TOKEN_SECRET=
PUBLISHER_KEYS_JSON='{}'

WS_QUEUE_CAPACITY=32
WS_MAX_CONNECTIONS=256
WS_MAX_MESSAGE_BYTES=16384
WS_AUTH_TIMEOUT=5s
WS_WRITE_TIMEOUT=5s
WS_PING_INTERVAL=30s
WS_PONG_TIMEOUT=10s
# Disable with 0s; positive values count time since the last client application text frame.
# Heartbeat pongs and outbound events do not reset this timeout.
WS_IDLE_TIMEOUT=0s
# Omit for same-origin only; explicitly empty is invalid.
# WS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000
DEMO_ENABLED=false

# Read only when SOCKETFABRIC_MODE=distributed. All NATS values are ignored in single mode.
NATS_URL=nats://localhost:4222
NATS_TOKEN=
NATS_SUBJECT_PREFIX=socketfabric
NATS_CONNECT_TIMEOUT=5s
NATS_PUBLISH_TIMEOUT=2s

# Gin reads this variable directly; release avoids debug output on stdout.
GIN_MODE=release

# Optional control plane. Values below are ignored while disabled.
MANAGEMENT_ENABLED=false
DATABASE_URL=
DATABASE_MAX_CONNS=8
DATABASE_CONNECT_TIMEOUT=2s
DATABASE_QUERY_TIMEOUT=2s
MANAGEMENT_SESSION_TTL=15m
MANAGEMENT_MAX_PROJECTS=128
MANAGEMENT_POLICY_REFRESH_INTERVAL=2s
MANAGEMENT_POLICY_MAX_AGE=5s
# Explicit local development only; production rejects true and requires DB verify-full.
MANAGEMENT_ALLOW_INSECURE_HTTP=false
# Explicit TLS-terminating proxy CIDRs; never trust a public address range.
MANAGEMENT_TRUSTED_PROXY_CIDRS=
# Optional development Compose only. Keep unset unless adding the management overlay.
POSTGRES_PASSWORD=
MANAGEMENT_DB_PORT=5432

# Developer CLI only; does not change gateway server configuration.
SOCKETFABRIC_URL=http://localhost:8080
SOCKETFABRIC_TIMEOUT=5s
SOCKETFABRIC_PROJECT_ID=
# Supply the existing project-scoped publisher key through a trusted environment.
SOCKETFABRIC_API_KEY=
