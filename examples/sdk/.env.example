# Application-only options; use docs/QUICKSTART.md for private generated ENV.
# This process reads ENV directly, without loading this file automatically.
EXAMPLE_ADDR=127.0.0.1:3000
EXAMPLE_ORIGIN=http://127.0.0.1:3000
EXAMPLE_PUBLIC_DIR=public
EXAMPLE_TOKEN_TTL=5m
EXAMPLE_USERS_JSON='{}'
SOCKETFABRIC_URL=http://127.0.0.1:8080
SOCKETFABRIC_WS_URLS=ws://127.0.0.1:8080/ws
SOCKETFABRIC_TIMEOUT=5s
# The same server-only credentials configured on the gateway.
CLIENT_TOKEN_SECRET=
PUBLISHER_KEYS_JSON='{}'
